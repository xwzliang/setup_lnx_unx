# Getting started:
#   cp env.example .env
#   chmod 600 .env
# Edit .env with your private subscription URLs. The script reads .env next to
# itself by default, even when launched from another directory. Use --env PATH
# to select a different file. .env is ignored by Git; keep its contents private.
# Values are literal: no shell commands, variable expansion or inline comments.
# Put comments on their own lines. Quotes around values are optional.
ROUTER=192.168.5.1
SSH_PORT=22
SUBCONVERTER_PORT=15051

# Choose ANY number of custom identifiers, separated by spaces. WGETCLOUD and
# MY_PROVIDER below are only examples, not reserved names or a two-entry limit.
# Each identifier must start with a letter and contain only letters, digits,
# and underscores (maximum 48 characters). Identifiers are case-sensitive.
# For each listed identifier, define SUB_<IDENTIFIER>_URL below.
SUBSCRIPTIONS="WGETCLOUD MY_PROVIDER"

# OpenClash runs ONE config at a time; --all does not merge subscriptions.
# This must be an identifier from SUBSCRIPTIONS. It is activated when included
# in an update; updating other identifiers preserves the running selection.
ACTIVE_SUBSCRIPTION=WGETCLOUD

# Required: replace these example URLs with real subscription URLs.
# If you only need one subscription, remove MY_PROVIDER from SUBSCRIPTIONS.
SUB_WGETCLOUD_URL="https://subscription.example.com/replace-with-your-private-url"
SUB_MY_PROVIDER_URL="https://subscription.example.com/another-private-url"

# Optional: SUB_<IDENTIFIER>_CONFIG sets the LuCI subscription name and filename
# under /etc/openclash/config/, WITHOUT the .yaml suffix. Defaults to the
# identifier. Config names must be unique, start with a letter or digit, and
# contain only letters, digits, underscores or hyphens (maximum 64 characters).
# This value preserves the name of the existing WGETCLOUD config on your router.
SUB_WGETCLOUD_CONFIG=wgetcloud_local_subconvert
# SUB_MY_PROVIDER_CONFIG=my_provider

# To add a third subscription named OFFICE:
#   1. Change SUBSCRIPTIONS to "WGETCLOUD MY_PROVIDER OFFICE".
#   2. Uncomment the next line and replace its URL.
#   3. Optionally define SUB_OFFICE_CONFIG and/or SUB_OFFICE_TEMPLATE.
# Repeat these steps with your own identifiers for any additional subscriptions.
# To rename MY_PROVIDER, change it in SUBSCRIPTIONS and every SUB_MY_PROVIDER_*
# key (and ACTIVE_SUBSCRIPTION if selected). Set CONFIG explicitly if you want
# to keep the same router filename/LuCI entry after renaming the identifier.
# SUB_OFFICE_URL="https://subscription.example.com/office-private-url"

# Default template for all subscriptions. Override for any identifier using
# SUB_<IDENTIFIER>_TEMPLATE. The existing subconverter fetches the source URL
# and applies this template before the script validates and installs the YAML.
TEMPLATE_URL="https://raw.githubusercontent.com/xwzliang/mysubconverter/refs/heads/master/myconfig/wgetcloud.ini"
# SUB_MY_PROVIDER_TEMPLATE="https://example.com/custom.ini"

# Run from this setup directory:
#   ./install_openclash_subscription.py --name MY_PROVIDER --check-only
#   ./install_openclash_subscription.py --name WGETCLOUD
#   ./install_openclash_subscription.py --name WGETCLOUD MY_PROVIDER
#   ./install_openclash_subscription.py --all
# --check-only converts and validates without changing OpenClash.
# Installation backs up existing configs/settings on the router before replacing
# them and prints the private backup directory. All selected conversions must
# pass validation first; an activation failure triggers restoration of old files.
