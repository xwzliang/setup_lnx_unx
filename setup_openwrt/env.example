# Copy to .env next to install_openclash_subscription.py; chmod 600 .env.
# Values are literal: no shell commands, variable expansion or inline comments.
ROUTER=192.168.5.1
SSH_PORT=22
SUBCONVERTER_PORT=15051

# Space-separated identifiers (case-sensitive). OpenClash runs only one config.
SUBSCRIPTIONS="WGETCLOUD SECONDARY"
ACTIVE_SUBSCRIPTION=WGETCLOUD

# Replace both example URLs, or remove SECONDARY from SUBSCRIPTIONS.
SUB_WGETCLOUD_URL="https://subscription.example.com/replace-with-your-private-url"
# Filename / LuCI subscription name, without .yaml. Preserve the existing name.
SUB_WGETCLOUD_CONFIG=wgetcloud_local_subconvert
SUB_SECONDARY_URL="https://subscription.example.com/another-private-url"
SUB_SECONDARY_CONFIG=secondary

# Default template for all subscriptions. Override with SUB_<IDENTIFIER>_TEMPLATE.
TEMPLATE_URL="https://raw.githubusercontent.com/xwzliang/mysubconverter/refs/heads/master/myconfig/wgetcloud.ini"
# SUB_SECONDARY_TEMPLATE="https://example.com/custom.ini"
